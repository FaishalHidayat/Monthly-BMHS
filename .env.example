# Koneksi PostgreSQL (Supabase pooler port 6543, atau PostgreSQL lokal)
DATABASE_URL=postgres://bmhs_app.<project-ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
# Rahasia untuk sesi login & enkripsi API key (string acak panjang)
AUTH_SECRET=ganti-dengan-string-acak-panjang
# Opsional: set "false" untuk PostgreSQL lokal tanpa SSL
# DATABASE_SSL=false
# Opsional: API key cadangan bila belum diisi lewat menu Pengaturan
# ANTHROPIC_API_KEY=
